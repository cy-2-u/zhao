{
  "name": "auto-review",
  "version": "0.8.1",
  "description": "ZCode 全自动审批权限插件（模拟 Codex 全自动模式，运行时零第三方依赖）",
  "type": "module",
  "private": true,
  "author": "hh-zyb",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test scripts/unit_tests.test.js scripts/scenario_tests.test.js && node scripts/smoke_test.js",
    "test:unit": "node --test scripts/unit_tests.test.js",
    "test:scenario": "node --test scripts/scenario_tests.test.js",
    "test:smoke": "node scripts/smoke_test.js"
  }
}
