{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|ApplyPatch|WebSearch|WebFetch|mcp__web_reader__webReader",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/src/hook_main.js"],
            "timeoutMs": 120000,
            "statusMessage": "安全子agent审查中"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Write|Edit|ApplyPatch|WebSearch|WebFetch|mcp__web_reader__webReader",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/src/hook_permission.js"],
            "timeoutMs": 120000,
            "statusMessage": "安全子agent审查权限请求"
          }
        ]
      }
    ]
  }
}
