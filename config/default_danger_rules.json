[
  {
    "pattern": "rm\\s+-([a-z]*r[a-z]*f|[a-z]*f[a-z]*r)[a-z]*\\s+(/+\\*?(\\s|$)|~(\\/+(\\s|$)|\\s|$)|\\$HOME([\\\\/]+(\\s|$)|\\s|$)|[a-z]:[\\\\/]+(\\s|$))",
    "action": "deny",
    "description": "递归强制删除根目录/家目录/盘符，不可恢复"
  },
  {
    "pattern": "^(format(\\.(exe|com))?|mkfs(\\.[a-z0-9]+)?|diskpart(\\.exe)?)\\s|^(format(\\.(exe|com))?|mkfs(\\.[a-z0-9]+)?|diskpart(\\.exe)?)$",
    "action": "deny",
    "description": "格式化磁盘/分区表操作（命令名后必须紧跟空白或结束，不误伤 Format-Table 等 cmdlet）"
  },
  {
    "pattern": "\\bdd\\s+[^;|&]*of=/dev/(sd|nvme|disk)",
    "action": "deny",
    "description": "dd 直接写入块设备，可致整盘数据损毁"
  },
  {
    "pattern": ":\\(\\)\\{.*\\};:",
    "action": "deny",
    "description": "fork 炸弹，会耗尽系统进程资源"
  },
  {
    "pattern": "chmod\\s+-R\\s+777\\s+/",
    "action": "deny",
    "description": "对根目录递归放开全部权限"
  },
  {
    "pattern": "\\b(shutdown(\\.exe)?|win32shutdown|restart-computer|stop-computer|halt|poweroff|reboot)\\b",
    "action": "deny",
    "description": "关机/重启/电源操作（含包装形态）：交模型结合完整命令裁决——真实电源中断倾向拒绝，取消已排定关机（shutdown /a）等取消动作属低风险可放行；插件规则层不直接转人工"
  }
]
